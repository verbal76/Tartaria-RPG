# Project-level npm config.
#
# legacy-peer-deps=true — required because jest-expo@52.0.6 transitively
# pulls in react-server-dom-webpack@19.0.0-rc, which has a peer
# dependency on react@19.0.0-rc, but the Expo SDK 52 project root pins
# react@18.3.1. npm 7+ defaults to strict peer resolution, which makes
# `npm ci` fail at install. With legacy-peer-deps=true, npm uses the
# older "warn but proceed" behavior — same as npm 6.
#
# This is also what react-native-executorch needs at install time: its
# companion package (-expo-resource-fetcher) requires Expo SDK 54, which
# we don't use, but its presence in the registry's peer chain trips
# npm's resolver under strict mode.
#
# Same flag would catch any future package whose peers conflict with
# our pinned root deps without us having to think about it.
legacy-peer-deps=true
