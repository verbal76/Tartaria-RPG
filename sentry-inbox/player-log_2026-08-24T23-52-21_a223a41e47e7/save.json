itchSeq":15,"memorableEvents":[{"id":"evt_1786239966200_8zgwu1","timestamp":1786239966200,"kind":"first_kill","text":"put down your first Bog Hound","enemyName":"Bog Hound"},{"id":"evt_1786243844546_7026ep","timestamp":1786243844546,"kind":"death_revive","text":"returned from death by a Resurrection Gem"},{"id":"evt_1786247630531_m5bcfr","timestamp":1786247630531,"kind":"death_revive","text":"returned from death by a Resurrection Gem"}],"npcTranscripts":{"halem_trader":[{"q":"Ask how business is","a":"\"Business is people,\" Halem says cheerfully, moving a crate that did not need moving. \"Everything on this post came off somebody who needed something else more. I do not think there is a single new thing in Tartaria. Just things that have changed hands enough times to look new.\"","ts":1786243850320},{"q":"Ask about the trading post","a":"\"It was my father's, and it was not a post then, it was a front room.\" He gestures at the roof, which is three different roofs. \"Every bit of this is somebody's payment. That beam is a debt. That shutter is a debt. I have been paid in doors more times than in coin.\" He grins. \"Do not tell anybody. It is the only reason I have a building.\"","ts":1787615340663},{"q":"Ask who else trades the crossroads","a":"\"Everyone, twice a season; nobody, the rest of it.\" Halem counts on his fingers. \"Felra for boots — go to her, do not let me sell you boots. Irma if you plan to be hit. Tellin if you want a fair number said to your face.\" He grins. \"And me for everything in between, which is where all the living actually happens.\"","ts":1787615341413},{"q":"Ask about the acid trade","a":"\"Careful with that shelf.\" Halem slides a wax-sealed flask an inch further from your elbow. \"Battery bile. The old world kept its lightning in acid — jar-batteries taller than a house, vault floors full of them. The flood shorted the lightning out and left the bile leaking for a thousand years. Scavengers milk the jars that held; I cut it with aether dust so it eats armor instead of hands.\" He taps the wax. \"Sells to people who plan on winning slowly.\"","ts":1787615342132}]},"talkedTopics":{"halem_trader:halem_trade":1,"halem_trader:halem_post":1,"halem_trader:halem_neighbors":1,"halem_trader:halem_acid":1},"chainMemos":[],"strandedEscortRolledTiles":["builders_survey_camp:42:20"],"lastRaidHour":15.399999999999997,"spireMoveNoticeShown":false,"hubVisitedFor":"builders_survey_camp"}}
