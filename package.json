    "expo-av": "~15.0.2",
    "expo-build-properties": "^55.0.14",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.26.0",
    "onnxruntime-react-native": "^1.24.3",
    "react": "18.3.1",
