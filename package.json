{
  "name": "tartaria-realms",
  "version": "2.0.1",
  "main": "expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "postinstall": "patch-package",
    "typecheck:ci": "tsc -p tsconfig.ci.json --noEmit",
    "typecheck:tests": "node scripts/ci-typecheck-tests.mjs",
    "test:ci": "npm run test:ci:fast && npm run test:ci:heavy",
    "test:ci:fast": "jest --ci --testPathIgnorePatterns /node_modules/ Stress stressMode Chaos Probe Smoke Sweep Sim",
    "test:ci:heavy": "jest --ci --maxWorkers=1 --workerIdleMemoryLimit=200MB --testPathPattern \"(Stress|stressMode|Chaos|Probe|Smoke|Sweep|Sim)\"",
    "check:handoff": "node scripts/check-handoff-claims.mjs",
    "check:reachability": "node scripts/check-reachability.mjs",
    "check:huntstages": "node scripts/check-hunt-stages.mjs",
    "export:web": "expo export --platform web",
    "check:lines": "node scripts/verify-lines.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@sentry/react-native": "6.10.0",
    "expo": "~52.0.0",
    "expo-application": "~6.0.0",
    "expo-asset": "~11.0.0",
    "expo-av": "~15.0.2",
    "expo-build-properties": "^55.0.14",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.0",
    "expo-intent-launcher": "~12.0.0",
    "expo-navigation-bar": "~4.0.0",
    "expo-speech": "~13.0.1",
    "expo-speech-recognition": "^1.1.1",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.26.0",
    "llama.rn": "^0.4.0",
    "onnxruntime-react-native": "^1.24.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.3",
    "react-native-executorch": "^0.8.4",
    "react-native-safe-area-context": "4.12.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@eslint/js": "9.39.0",
    "@types/jest": "^29.5.13",
    "@types/react": "~18.3.12",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.3.3",
    "typescript-eslint": "8.64.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage/jest/async-storage-mock$": "<rootDir>/test-utils/asyncStorageMock.js"
    }
  }
}
