{
  "name": "tartaria-realms",
  "version": "2.0.1",
  "main": "expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "postinstall": "patch-package",
    "typecheck:ci": "tsc -p tsconfig.ci.json --noEmit",
    "typecheck:tests": "node scripts/ci-typecheck-tests.mjs",
    "test:ci": "npm run test:ci:fast && npm run test:ci:heavy",
    "test:ci:fast": "jest --ci --testPathIgnorePatterns /node_modules/ \"$(node scripts/heavy-suites.mjs --pattern)\"",
    "test:ci:fast:shard": "node scripts/shard-suites.cjs --run",
    "test:ci:heavy": "jest --ci --maxWorkers=1 --workerIdleMemoryLimit=200MB --testPathPattern \"$(node scripts/heavy-suites.mjs --pattern)\"",
    "check:handoff": "node scripts/check-handoff-claims.mjs",
    "check:reachability": "node scripts/check-reachability.mjs",
    "check:huntstages": "node scripts/check-hunt-stages.mjs",
    "check:requires": "node scripts/check-requires.mjs",
    "export:web": "expo export --platform web",
    "check:lines": "node scripts/verify-lines.mjs",
    "check:verbreach": "node scripts/check-verb-reach.mjs",
    "check:chevrons": "node scripts/check-chevrons.mjs",
    "check:standingat": "node scripts/check-standing-at.mjs",
    "check:otastamp": "node scripts/check-ota-stamp.mjs",
    "check:quotedpins": "node scripts/check-quoted-pins.mjs",
    "check:gold": "node scripts/check-gold.mjs",
    "check:voicepools": "node scripts/check-voice-pools.mjs",
    "check:slicepins": "node scripts/check-slice-pins.mjs",
    "check:missionclaims": "node scripts/check-mission-claims.mjs",
    "check:guardianclaims": "node scripts/check-guardian-claims.mjs",
    "check:weaponnames": "node scripts/check-weapon-names.mjs",
    "check:storeceiling": "node scripts/check-store-ceiling.mjs",
    "check:kitpalette": "node scripts/check-kit-palette.mjs",
    "check:kitexports": "node scripts/check-kit-exports.mjs",
    "check:testsplit": "node scripts/check-test-split.mjs",
    "check:requiredjobs": "node scripts/check-required-jobs.mjs",
    "check:shardcoverage": "node scripts/check-shard-coverage.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@sentry/react-native": "~6.14.0",
    "expo": "~53.0.27",
    "expo-application": "~6.1.5",
    "expo-asset": "~11.1.7",
    "expo-av": "~15.1.7",
    "expo-build-properties": "~0.14.8",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-intent-launcher": "~12.1.5",
    "expo-navigation-bar": "~4.2.8",
    "expo-speech": "~13.1.7",
    "expo-speech-recognition": "^1.1.1",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.18",
    "llama.rn": "^0.4.0",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-executorch": "^0.8.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-web": "~0.20.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@eslint/js": "9.39.0",
    "@types/jest": "^29.5.13",
    "@types/react": "~18.3.12",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.3.3",
    "typescript-eslint": "8.64.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage/jest/async-storage-mock$": "<rootDir>/test-utils/asyncStorageMock.js"
    }
  }
}