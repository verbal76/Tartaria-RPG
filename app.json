{
  "expo": {
    "name": "Tartaria Realms",
    "slug": "tartaria-",
    "owner": "hot-attic-games",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tartariarealms",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0a0908",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.verbal76.tartariarealms"
    },
    "android": {
      "package": "com.verbal76.tartariarealms",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0908"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "af723f5e-e446-4296-aa6e-f1d4a4fbe82a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/af723f5e-e446-4296-aa6e-f1d4a4fbe82a",
      "requestHeaders": {
        "expo-channel-name": "preview"
      },
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
