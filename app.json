{
  "expo": {
    "name": "Tartaria Realms HAL",
    "slug": "tartaria-",
    "owner": "hot-attic-games",
    "version": "2.4.1",
    "orientation": "portrait",
    "scheme": "tartariarealms",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0a0908",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hotatticgames.tartarprim.hal2001.ios",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.hotatticgames.tartarprim.hal2001",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0908"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withJetifier",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Tartaria Realms to access the microphone for speech-to-text input.",
          "speechRecognitionPermission": "Allow Tartaria Realms to recognize your speech for in-game commands."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "af723f5e-e446-4296-aa6e-f1d4a4fbe82a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/af723f5e-e446-4296-aa6e-f1d4a4fbe82a",
      "requestHeaders": {
        "expo-channel-name": "ios-preview"
      },
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
