+  /**
+   * Tartaria Realms patch (OTA-273 / Pewter Vault).
+   *
+   * Returns true for SoCs/devices known to crash with SIGILL when the
+   * v8.4-compiled variants of librnllama are loaded. These are ARMv8.2-A
+   * chips that report enough v8.3+/v8.5+ cherry-picked features in
+   * /proc/cpuinfo to fool the upstream substring heuristic into
+   * thinking they're v8.4-a, but they lack v8.4 baseline instructions.
+   *
+   * For blocklisted chips, the static initializer forces
+   * isAtLeastArmV84 = false, so selection falls through to
+   * rnllama_v8_2_fp16_dotprod (compiled -march=armv8.2-a+fp16+dotprod).
+   * Every instruction in that set is present on Snapdragon 865 / Exynos
+   * 990 / SD7xx-class chips.
+   *
+   * Detection priority:
+   *   1. Build.SOC_MODEL (API 31+, exact SoC identifier from kernel).
+   *   2. Build.HARDWARE board codename (covers older API levels).
+   *   3. Build.MODEL prefix match (specific Samsung Galaxy S20/Note20).
+   */
+  private static boolean isKnownMisclassifiedChip() {
+    // 1. SoC model match (API 31+ only).
+    if (Build.VERSION.SDK_INT >= 31 && Build.SOC_MODEL != null) {
+      String soc = Build.SOC_MODEL.toUpperCase();
+      if (soc.startsWith("SM8250")        // Snapdragon 865 / 865+
+          || soc.startsWith("SM7250")      // Snapdragon 765G / 768G (Pixel 5)
+          || soc.startsWith("SM7350")      // Snapdragon 780G
+          || soc.startsWith("SM7450")      // Snapdragon 7 Gen 1 (llama.rn #279)
+          || soc.startsWith("SDM865")
+          || soc.startsWith("SDM765")
+          || soc.startsWith("SDM730")
+          || soc.startsWith("EXYNOS990")
+          || soc.startsWith("EXYNOS9820")
+          || soc.startsWith("EXYNOS9825")) {
+        Log.d(NAME, "Tartaria blocklist hit via Build.SOC_MODEL: " + soc);
+        return true;
+      }
+    }
+
+    // 2. Board / hardware codename match.
+    String hardware = Build.HARDWARE == null ? "" : Build.HARDWARE.toLowerCase();
+    if (hardware.equals("kona")           // SD865 reference platform
+        || hardware.equals("lito")        // SD765G / SD7xx 5G
+        || hardware.equals("bengal")) {   // SD662/680/685 budget class
+      Log.d(NAME, "Tartaria blocklist hit via Build.HARDWARE: " + hardware);
+      return true;
+    }
+
+    // 3. Device model prefix match (Samsung Galaxy S20 + Note 20).
+    String model = Build.MODEL == null ? "" : Build.MODEL.toUpperCase();
+    if (model.startsWith("SM-G980")       // S20 (Exynos 990)
+        || model.startsWith("SM-G981")    // S20 5G (SD865)
+        || model.startsWith("SM-G985")    // S20+ (Exynos 990)
+        || model.startsWith("SM-G986")    // S20+ 5G (SD865)
+        || model.startsWith("SM-G988")    // S20 Ultra (SD865 / Exynos 990)
+        || model.startsWith("SM-N980")    // Note 20 (Exynos 990 / SD865+)
+        || model.startsWith("SM-N981")    // Note 20 5G (SD865+)
+        || model.startsWith("SM-N985")    // Note 20 Ultra (Exynos 990)
+        || model.startsWith("SM-N986")) { // Note 20 Ultra 5G (SD865+)
+      Log.d(NAME, "Tartaria blocklist hit via Build.MODEL: " + model);
+      return true;
+    }
+
+    return false;
+  }
